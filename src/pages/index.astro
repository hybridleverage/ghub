---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="BrightView Agency builds AI-powered automation systems for local businesses — so you can stop doing everything manually and start scaling." />
  <title>BrightView Agency — AI Automation for Local Businesses</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #050d1a;
      --navy2:  #0a1628;
      --navy3:  #0f2040;
      --cyan:   #00d4ff;
      --cyan2:  #00aacc;
      --bright: #f0faff;
      --white:  #ffffff;
      --gray:   #8ba0b8;
      --card:   #0d1e36;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--navy);
      color: var(--bright);
      line-height: 1.6;
    }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 2rem;
      background: rgba(5, 13, 26, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0,212,255,0.1);
    }
    .logo {
      font-size: 1.4rem; font-weight: 800;
      color: var(--white);
      letter-spacing: -0.5px;
    }
    .logo span { color: var(--cyan); }
    .nav-cta {
      background: var(--cyan); color: var(--navy);
      padding: .55rem 1.4rem; border-radius: 6px;
      font-weight: 700; font-size: .9rem;
      text-decoration: none;
      transition: background .2s;
    }
    .nav-cta:hover { background: var(--cyan2); }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center;
      padding: 8rem 1.5rem 5rem;
      position: relative; overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(0,212,255,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-badge {
      display: inline-block;
      background: rgba(0,212,255,0.12);
      border: 1px solid rgba(0,212,255,0.3);
      color: var(--cyan);
      font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
      padding: .4rem 1rem; border-radius: 50px;
      margin-bottom: 1.8rem;
    }
    .hero h1 {
      font-size: clamp(2.4rem, 6vw, 4.2rem);
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -1.5px;
      max-width: 820px;
      margin-bottom: 1.4rem;
    }
    .hero h1 .highlight {
      color: var(--cyan);
      position: relative;
    }
    .hero p {
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: var(--gray);
      max-width: 580px;
      margin: 0 auto 2.5rem;
    }
    .hero-ctas {
      display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;
    }
    .btn-primary {
      background: var(--cyan); color: var(--navy);
      padding: .85rem 2rem; border-radius: 8px;
      font-weight: 700; font-size: 1rem;
      text-decoration: none;
      transition: transform .2s, background .2s;
      display: inline-block;
    }
    .btn-primary:hover { background: var(--cyan2); transform: translateY(-2px); }
    .btn-secondary {
      background: transparent; color: var(--bright);
      padding: .85rem 2rem; border-radius: 8px;
      font-weight: 600; font-size: 1rem;
      text-decoration: none;
      border: 1.5px solid rgba(255,255,255,0.2);
      transition: border-color .2s, transform .2s;
      display: inline-block;
    }
    .btn-secondary:hover { border-color: var(--cyan); transform: translateY(-2px); }

    /* PAIN STRIP */
    .pain-strip {
      background: var(--navy3);
      border-top: 1px solid rgba(0,212,255,0.1);
      border-bottom: 1px solid rgba(0,212,255,0.1);
      padding: 2rem 1.5rem;
      text-align: center;
    }
    .pain-strip p {
      font-size: 1.05rem; color: var(--gray);
      max-width: 700px; margin: 0 auto;
    }
    .pain-strip strong { color: var(--bright); }

    /* SECTION BASE */
    section { padding: 5rem 1.5rem; }
    .container { max-width: 1100px; margin: 0 auto; }
    .section-label {
      font-size: .75rem; font-weight: 700; letter-spacing: .12em;
      text-transform: uppercase; color: var(--cyan);
      margin-bottom: .8rem;
    }
    .section-title {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 800; letter-spacing: -1px;
      margin-bottom: 1rem;
    }
    .section-sub {
      color: var(--gray); font-size: 1.05rem;
      max-width: 560px;
      margin-bottom: 3rem;
    }

    /* WHAT WE DO */
    .services { background: var(--navy2); }
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    .service-card {
      background: var(--card);
      border: 1px solid rgba(0,212,255,0.1);
      border-radius: 12px;
      padding: 1.8rem;
      transition: border-color .2s, transform .2s;
    }
    .service-card:hover { border-color: rgba(0,212,255,0.4); transform: translateY(-3px); }
    .service-icon {
      font-size: 2rem; margin-bottom: 1rem;
    }
    .service-card h3 {
      font-size: 1.1rem; font-weight: 700;
      margin-bottom: .5rem;
    }
    .service-card p { color: var(--gray); font-size: .95rem; }

    /* HOW IT WORKS */
    .how { background: var(--navy); }
    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 2rem; counter-reset: step;
    }
    .step { position: relative; }
    .step-num {
      font-size: 3rem; font-weight: 900;
      color: rgba(0,212,255,0.15);
      line-height: 1; margin-bottom: .5rem;
    }
    .step h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: .4rem; }
    .step p { color: var(--gray); font-size: .92rem; }

    /* PROOF */
    .proof { background: var(--navy3); }
    .proof-box {
      background: var(--card);
      border: 1px solid rgba(0,212,255,0.2);
      border-left: 4px solid var(--cyan);
      border-radius: 12px;
      padding: 2.5rem;
      max-width: 780px;
    }
    .proof-box blockquote {
      font-size: 1.15rem; font-style: italic;
      color: var(--bright); margin-bottom: 1.2rem; line-height: 1.7;
    }
    .proof-author { color: var(--gray); font-size: .9rem; }
    .proof-author strong { color: var(--cyan); }

    /* WHO WE SERVE */
    .who { background: var(--navy2); }
    .who-grid {
      display: flex; flex-wrap: wrap; gap: 1rem;
    }
    .who-pill {
      background: var(--card);
      border: 1px solid rgba(0,212,255,0.15);
      border-radius: 50px;
      padding: .6rem 1.3rem;
      font-size: .95rem; font-weight: 500;
      color: var(--bright);
    }

    /* LEAD FORM */
    .lead { background: var(--navy); }
    .lead-wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    @media (max-width: 768px) {
      .lead-wrap { grid-template-columns: 1fr; gap: 2rem; }
    }
    .lead-copy h2 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 800; letter-spacing: -1px; margin-bottom: 1rem; }
    .lead-copy p { color: var(--gray); font-size: 1rem; }
    .lead-copy ul { margin-top: 1.5rem; list-style: none; display: flex; flex-direction: column; gap: .7rem; }
    .lead-copy ul li { color: var(--gray); font-size: .95rem; padding-left: 1.4rem; position: relative; }
    .lead-copy ul li::before { content: '→'; position: absolute; left: 0; color: var(--cyan); }

    form {
      background: var(--card);
      border: 1px solid rgba(0,212,255,0.15);
      border-radius: 14px;
      padding: 2.2rem;
    }
    .form-group { margin-bottom: 1.2rem; }
    label { display: block; font-size: .85rem; font-weight: 600; color: var(--gray); margin-bottom: .4rem; }
    input, select, textarea {
      width: 100%;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(0,212,255,0.2);
      border-radius: 8px;
      padding: .75rem 1rem;
      color: var(--bright);
      font-family: 'Inter', sans-serif;
      font-size: .95rem;
      outline: none;
      transition: border-color .2s;
    }
    input::placeholder, textarea::placeholder { color: rgba(255,255,255,0.25); }
    input:focus, select:focus, textarea:focus { border-color: var(--cyan); }
    select option { background: var(--navy2); }
    textarea { resize: vertical; min-height: 90px; }
    .form-submit {
      width: 100%;
      background: var(--cyan); color: var(--navy);
      border: none; cursor: pointer;
      padding: .9rem; border-radius: 8px;
      font-weight: 700; font-size: 1rem;
      font-family: 'Inter', sans-serif;
      transition: background .2s, transform .2s;
      margin-top: .5rem;
    }
    .form-submit:hover { background: var(--cyan2); transform: translateY(-2px); }
    .form-note { font-size: .78rem; color: var(--gray); text-align: center; margin-top: .8rem; }

    /* FOOTER */
    footer {
      background: var(--navy2);
      border-top: 1px solid rgba(0,212,255,0.08);
      padding: 2.5rem 1.5rem;
      text-align: center;
    }
    .footer-logo { font-size: 1.2rem; font-weight: 800; margin-bottom: .5rem; }
    .footer-logo span { color: var(--cyan); }
    footer p { color: var(--gray); font-size: .85rem; }

    /* GLOW DOTS */
    .glow-dot {
      display: inline-block;
      width: 8px; height: 8px;
      background: var(--cyan);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--cyan);
      margin-right: .5rem;
      vertical-align: middle;
    }
  </style>
</head>
<body>

  <!-- NAV -->
  <nav>
    <div class="logo"><span>Bright</span>View Agency</div>
    <a href="#contact" class="nav-cta">Get a Free Audit</a>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-badge"><span class="glow-dot"></span>AI-Powered Business Automation</div>
    <h1>Stop Running Your Business.<br><span class="highlight">Let It Run Itself.</span></h1>
    <p>BrightView Agency builds custom AI automation systems that handle your repetitive work — so you can focus on what actually grows your business.</p>
    <div class="hero-ctas">
      <a href="#contact" class="btn-primary">Book a Free Consultation</a>
      <a href="#services" class="btn-secondary">See What We Automate</a>
    </div>
  </section>

  <!-- PAIN STRIP -->
  <div class="pain-strip">
    <p>Most local businesses are <strong>losing 10–20 hours a week</strong> to tasks a well-built AI system could handle — dispatching, follow-ups, scheduling, reporting, and more.</p>
  </div>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="container">
      <p class="section-label">What We Build</p>
      <h2 class="section-title">Automation That Actually Works<br>for Your Business</h2>
      <p class="section-sub">We don't sell software. We build systems tailored to how your business operates — then hand you the keys.</p>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">📬</div>
          <h3>Smart Inbox & Lead Response</h3>
          <p>AI monitors your email and messages, routes inquiries, sends instant replies, and flags anything urgent — 24/7, no delays.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🚚</div>
          <h3>Dispatch & Order Management</h3>
          <p>Automatically create, assign, and track orders across platforms. Perfect for delivery, service, and logistics businesses.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📅</div>
          <h3>Scheduling & Follow-Up</h3>
          <p>Automated appointment reminders, rebooking flows, and client follow-ups that run on autopilot — no more dropped balls.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📊</div>
          <h3>Reporting & Insights</h3>
          <p>Weekly summaries, payment reports, and performance snapshots delivered straight to your phone — formatted exactly how you need them.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">💬</div>
          <h3>Multi-Channel Communication</h3>
          <p>Unified messaging across Telegram, WhatsApp, SMS, and email. Your AI assistant speaks to customers and your team in the right place.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>Custom Workflow Automation</h3>
          <p>If your business has a repeatable process that eats time, we build the system that handles it — end to end, without you touching it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how" id="how">
    <div class="container">
      <p class="section-label">The Process</p>
      <h2 class="section-title">From Consultation to<br>Running on Autopilot</h2>
      <p class="section-sub">Simple. Fast. Built around the way your business actually works.</p>
      <div class="steps">
        <div class="step">
          <div class="step-num">01</div>
          <h3>Free Business Audit</h3>
          <p>We map your current workflows, identify the biggest time sinks, and show you exactly where automation wins.</p>
        </div>
        <div class="step">
          <div class="step-num">02</div>
          <h3>Custom System Design</h3>
          <p>We design your automation stack from scratch — no generic tools, no templates. Built for your business, your tools, your team.</p>
        </div>
        <div class="step">
          <div class="step-num">03</div>
          <h3>Build & Deploy</h3>
          <p>We build and launch your system fast — typically within 1–2 weeks. You stay informed without having to do the work.</p>
        </div>
        <div class="step">
          <div class="step-num">04</div>
          <h3>Ongoing Optimization</h3>
          <p>Your business evolves — your automation does too. We monitor, refine, and expand your system as you grow.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="proof" id="proof">
    <div class="container">
      <p class="section-label">Real Results</p>
      <h2 class="section-title">Built for Businesses<br>Like Yours</h2>
      <div class="proof-box">
        <blockquote>"We automated our entire dispatch operation — order creation, driver assignment, payment reports, and real-time monitoring. What used to take hours every night now runs automatically. The system works while I sleep."</blockquote>
        <p class="proof-author"><strong>Rudy Baptiste</strong> — Owner, RGTDRIVERS LLC | Courier & Medical Delivery</p>
      </div>
    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="who" id="who">
    <div class="container">
      <p class="section-label">Who We Work With</p>
      <h2 class="section-title">If You Run a Local Business,<br>We Can Help</h2>
      <p class="section-sub" style="margin-bottom:2rem;">We work with small and mid-size businesses across every industry that has repeatable operations.</p>
      <div class="who-grid">
        <span class="who-pill">🚚 Delivery & Logistics</span>
        <span class="who-pill">🏥 Medical & Healthcare Services</span>
        <span class="who-pill">🏠 Home Services & Contractors</span>
        <span class="who-pill">🍽️ Restaurants & Catering</span>
        <span class="who-pill">💈 Salons & Spas</span>
        <span class="who-pill">🔧 Auto Repair Shops</span>
        <span class="who-pill">🏋️ Fitness & Wellness</span>
        <span class="who-pill">🏗️ Construction & Trades</span>
        <span class="who-pill">📦 E-Commerce & Fulfillment</span>
        <span class="who-pill">🏢 Property Management</span>
        <span class="who-pill">📸 Event & Creative Services</span>
        <span class="who-pill">+ Any business with repeatable work</span>
      </div>
    </div>
  </section>

  <!-- LEAD FORM -->
  <section class="lead" id="contact">
    <div class="container">
      <div class="lead-wrap">
        <div class="lead-copy">
          <p class="section-label">Let's Talk</p>
          <h2>Get Your Free<br>Automation Audit</h2>
          <p>Tell us about your business and we'll show you exactly where automation can save you time and money — no pressure, no obligation.</p>
          <ul>
            <li>Free 30-minute strategy session</li>
            <li>Custom automation roadmap for your business</li>
            <li>No tech background required</li>
            <li>Results within the first 30 days</li>
          </ul>
        </div>
        <form id="lead-form" action="https://formspree.io/f/xyzwvqpk" method="POST">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required />
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="you@yourbusiness.com" required />
          </div>
          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="(555) 000-0000" />
          </div>
          <div class="form-group">
            <label for="business">Business Type</label>
            <select id="business" name="business_type">
              <option value="" disabled selected>Select your industry</option>
              <option>Delivery & Logistics</option>
              <option>Medical & Healthcare</option>
              <option>Home Services / Contractors</option>
              <option>Restaurant & Catering</option>
              <option>Salon & Spa</option>
              <option>Auto Repair</option>
              <option>Fitness & Wellness</option>
              <option>Construction & Trades</option>
              <option>E-Commerce & Fulfillment</option>
              <option>Property Management</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="challenge">Biggest Time Waster Right Now</label>
            <textarea id="challenge" name="challenge" placeholder="What's eating up your time? (e.g., manually dispatching orders, chasing leads, writing reports...)"></textarea>
          </div>
          <button type="submit" class="form-submit">Get My Free Audit →</button>
          <p class="form-note">No spam. No pressure. Just real strategy.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="footer-logo"><span>Bright</span>View Agency</div>
    <p>AI-Powered Automation for Local Businesses</p>
    <p style="margin-top:.5rem;">© 2026 BrightView Agency. All rights reserved.</p>
  </footer>

</body>
</html>
