---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';

const live = [
  { icon: 'phone', title: 'AI receptionist', text: 'Answers every call in a natural voice, takes the details, and transfers to you when a caller needs a person.' },
  { icon: 'missed', title: 'Missed-call text-back', text: 'When a call goes unanswered, Neo texts the caller within a minute and books them by text, before they call your competitor.' },
  { icon: 'bolt', title: 'Instant lead follow-up', text: 'Website forms and emailed leads get a reply in under a minute, then follow-ups on days 1, 3 and 7 until they book or say stop.' },
  { icon: 'book', title: 'Knowledge base', text: 'Neo answers from your own price list, FAQ and policies. Change a price from your phone and Neo uses it on the next call.' },
  { icon: 'shield', title: 'Approval mode', text: 'Anything public, costly or in bulk waits for you. One tap on Telegram to approve or reject.' },
  { icon: 'send', title: 'Run it from Telegram', text: 'Every call, text and lead is copied to you. Ask Neo for a report or give it a job in plain English, from anywhere.' },
];
const industries = [
  { icon: 'truck', name: 'Courier & delivery', status: 'live', href: '/industries/courier' },
  { icon: 'scale', name: 'Law firms', status: 'soon', href: '/industries/law' },
  { icon: 'home', name: 'Home services', status: 'soon', href: '/industries#home-services' },
  { icon: 'scissors', name: 'Salons & barbers', status: 'soon', href: '/industries#salons' },
  { icon: 'heart', name: 'Clinics & wellness', status: 'soon', href: '/industries#clinics' },
];
const faqs = [
  ['Will callers know they’re talking to AI?', 'Neo introduces itself as a virtual receptionist. It speaks naturally, keeps answers short, and hands the call to you whenever a caller asks for a person.'],
  ['Can Neo send or spend anything without me?', 'Not anything public, costly or in bulk. Approval mode sends you a Telegram message with Approve and Reject buttons, and nothing goes out until you tap.'],
  ['Do I have to change my phone number?', 'No. You can forward your existing number to Neo, or give Neo its own number. We set it up either way.'],
  ['How is it priced?', 'A monthly plan plus a one-time, done-for-you setup. We quote after a 30-minute consultation so the plan fits your call volume and tools.'],
];
---
<Base title="Brightview Agency: Neo, AI operations staff for small businesses"
  description="Neo answers your phone, texts back missed calls, follows up every lead in under a minute and runs your back office, while you approve anything that matters from Telegram.">

  <section class="hero">
    <div class="badge"><span class="dot"></span>Meet Neo</div>
    <h1>The AI operations staff your business <span class="hl">can’t afford to hire</span></h1>
    <p class="lead">Neo answers your phone, texts back missed calls, follows up every lead in under a minute, and runs your back office, while you approve anything that matters from Telegram.</p>
    <div class="ctas">
      <a href="/book" class="btn-primary">Book a consultation</a>
      <a href={`tel:${SITE.phoneTel}`} class="btn-secondary"><Icon name="phone" size={18} />Call Neo now: {SITE.phone}</a>
    </div>
    <p class="trust">Running every day at <strong>RGT Drivers</strong>, a Maryland medical courier. <a href="/case-studies/rgt-drivers">See how</a></p>
  </section>

  <div class="strip">
    <div class="strip-grid">
      <div><strong>Missed calls go to competitors</strong>Callers who reach voicemail often hang up and call the next business.</div>
      <div><strong>Leads go cold fast</strong>The business that answers first often wins the job.</div>
      <div><strong>You’re doing three jobs</strong>Receptionist, dispatcher and bookkeeper, on top of the work you actually sell.</div>
    </div>
  </div>

  <section class="alt" id="what-neo-does">
    <div class="container">
      <p class="section-label">Live today</p>
      <h2 class="section-title">What Neo does for you</h2>
      <p class="section-sub">Six modules running in production right now. Your plan decides which ones are switched on.</p>
      <div class="grid">
        {live.map((m) => (
          <div class="card">
            <div class="icon-tile"><Icon name={m.icon} /></div>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:1.8rem"><a href="/neo">See everything Neo does →</a></p>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="section-label">One brain, every channel</p>
      <h2 class="section-title">Every conversation, one memory</h2>
      <p class="section-sub">Phone, text and email all go through the same Neo, so it remembers each customer, and you see everything in one place.</p>
      <div class="flow" role="img" aria-label="Phone, text, email and web chat flow into Neo, which reports to you on Telegram">
        <div class="col">
          <div class="chip"><Icon name="phone" size={18} />Phone calls</div>
          <div class="chip"><Icon name="message" size={18} />Text messages</div>
          <div class="chip"><Icon name="book" size={18} />Email and web forms</div>
          <div class="chip"><Icon name="sparkle" size={18} />Web chat <span class="tag soon">Soon</span></div>
        </div>
        <div class="arrow"><Icon name="arrow" size={30} /></div>
        <div class="brain"><strong>Neo</strong><span>one memory of every customer</span></div>
        <div class="arrow"><Icon name="arrow" size={30} /></div>
        <div class="col">
          <div class="chip"><Icon name="send" size={18} />You, on Telegram</div>
          <div class="chip"><Icon name="shield" size={18} />One-tap approvals</div>
          <div class="chip"><Icon name="chart" size={18} />Reports on request</div>
        </div>
      </div>
    </div>
  </section>

  <section class="alt2">
    <div class="container grid-2" style="align-items:center">
      <div>
        <p class="section-label">You stay in control</p>
        <h2 class="section-title">AI staff that asks before it acts</h2>
        <ul class="checks">
          <li><strong>Approval mode.</strong> Marketing texts, bulk messages and unusual invoices wait for your tap.</li>
          <li><strong>Everything is copied to you.</strong> Every text Neo sends or receives shows up on your Telegram.</li>
          <li><strong>Industry guardrails.</strong> No patient details in texts. Never legal advice. Opt-outs honored instantly.</li>
        </ul>
      </div>
      <div>
        <p class="section-label">Your own private Neo</p>
        <h2 class="section-title">Your data stays yours</h2>
        <ul class="checks">
          <li><strong>Your own install.</strong> Each business gets its own server, phone number and database.</li>
          <li><strong>Nothing shared.</strong> No customer data moves between clients, ever.</li>
          <li><strong>Carrier-registered texting.</strong> We handle the registration carriers require for business texting.</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="section-label">Proof</p>
      <h2 class="section-title">Built inside a real business</h2>
      <div class="proof-box">
        <p style="font-size:1.08rem;margin-bottom:1rem">Neo runs RGT Drivers, a Maryland medical courier, every day. It creates and assigns deliveries, watches for late drivers, emails proof of delivery, builds payroll, answers the phone and follows up every lead.</p>
        <p class="proof-author"><strong>RGT Drivers</strong>, courier and medical delivery, Silver Spring, MD</p>
        <p class="disclosure">RGT Drivers is owned by Brightview’s founder. Neo was built and proven there before we offered it to anyone else.</p>
      </div>
      <p style="margin-top:1.4rem"><a href="/case-studies/rgt-drivers">Read the RGT Drivers story →</a></p>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <p class="section-label">Built for your industry</p>
      <h2 class="section-title">Set up from a template for your trade</h2>
      <p class="section-sub">Each template comes with the call script, intake questions, message wording and safety rules your industry needs.</p>
      <div class="grid">
        {industries.map((i) => (
          <a class="card" href={i.href}>
            <div class="icon-tile"><Icon name={i.icon} /></div>
            <h3>{i.name}<span class={`tag ${i.status}`}>{i.status === 'live' ? 'Live' : 'Early access'}</span></h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="section-label">How it works</p>
      <h2 class="section-title">From consultation to live, done for you</h2>
      <div class="steps">
        <div class="step"><div class="step-num">01</div><h3>Consultation</h3><p>30 minutes on how calls, leads and paperwork flow through your business today.</p></div>
        <div class="step"><div class="step-num">02</div><h3>Setup, done for you</h3><p>Your knowledge base, phone number, carrier registration for texting, and Telegram, all set up by us.</p></div>
        <div class="step"><div class="step-num">03</div><h3>Go live, approvals on</h3><p>Neo starts answering. Anything public or costly waits for your tap while you get comfortable.</p></div>
        <div class="step"><div class="step-num">04</div><h3>Tune-ups</h3><p>We review calls and messages with you and adjust Neo’s answers as your business changes.</p></div>
      </div>
      <p class="muted" style="margin-top:1.6rem">Most installs go live in two to three weeks. Texting switches on once the carriers approve your registration.</p>
    </div>
  </section>

  <section class="alt2">
    <div class="container">
      <p class="section-label">Coming soon</p>
      <h2 class="section-title">What’s next on the roadmap</h2>
      <div class="grid">
        <div class="card"><h3>Calendar booking and reminders</h3><p>Neo books straight onto your Google Calendar and texts a reminder the day before.</p></div>
        <div class="card"><h3>Morning briefing and weekly numbers</h3><p>Today’s jobs, yesterday’s money and anything needing attention, on Telegram at 7 AM.</p></div>
        <div class="card"><h3>Review engine</h3><p>Asks happy customers for a Google review after each job and routes unhappy ones to you.</p></div>
        <div class="card"><h3>Web chat and Spanish</h3><p>The same Neo as a chat bubble on your site, and calls and texts in Spanish.</p></div>
      </div>
    </div>
  </section>

  <section>
    <div class="container narrow faq">
      <p class="section-label">FAQ</p>
      <h2 class="section-title">Common questions</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      <p style="margin-top:1rem"><a href="/faq">More questions →</a></p>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>See what Neo would handle in your business</h2>
      <p>Book a 30-minute consultation. Or call Neo right now and hear it for yourself.</p>
      <div class="ctas">
        <a href="/book" class="btn-primary">Book a consultation</a>
        <a href={`tel:${SITE.phoneTel}`} class="btn-secondary"><Icon name="phone" size={18} />{SITE.phone}</a>
      </div>
    </div>
  </section>
</Base>
